# threadpool: producers enqueue; named workers pull from one queue.
# Render: d2 --layout elk --sketch --theme 302 docs/threadpool.d2 docs/threadpool.svg
direction: right

callers: Callers {
  style.multiple: true
  label: "enqueue · post · enqueue_bulk\nasync → std::future"
}

group: TaskGroup {
  label: "TaskGroup\nowner-scoped cancel + wait\nround-robin, capped"
}

queue: "PoolQueue\ntail lock · head lock" {
  shape: queue
}

workers: Workers {
  w0: "W00"
  w1: "W01"
  w2: "W02"
  w3: "W03"
}

callers -> queue
group -> queue: "per-group FIFO"
queue -> workers.w0
queue -> workers.w1
queue -> workers.w2
queue -> workers.w3
